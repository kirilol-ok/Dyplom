apiVersion: batch/v1
kind: Job
metadata:
  name: __JOB_NAME__
  namespace: __APP_NS__
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 900
  template:
    metadata:
      labels:
        app: k6
        benchmark-role: load-generator
    spec:
      serviceAccountName: k6
      restartPolicy: Never
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchLabels:
                  app: server
              topologyKey: kubernetes.io/hostname
      containers:
        - name: k6
          image: grafana/k6:0.53.0
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -c
            - |
              set -u
              set +e
              k6 run "/scripts/__K6_SCRIPT__"
              code=$?
              set -e
              touch /results/.k6-finished
              echo "k6 finished with code ${code}, waiting for result collection"
              i=0
              while [ ! -f /results/.copied ] && [ "$i" -lt 600 ]; do
                i=$((i + 1))
                sleep 1
              done
              exit "$code"
          env:
            - name: MODEL
              value: "__MODEL__"
            - name: VUS
              value: "__VUS__"
            - name: DURATION
              value: "__DURATION__"
            - name: TARGET_URL
              value: "__TARGET_URL__"
            - name: TARGET_MODE
              value: "__TARGET_MODE__"
            - name: RPS
              value: "__RPS__"
            - name: PAYLOAD_SIZE
              value: "__PAYLOAD_SIZE__"
            - name: RESPONSE_SIZE
              value: "__RESPONSE_SIZE__"
            - name: REQUEST_METHOD
              value: "__REQUEST_METHOD__"
            - name: REQUEST_PATH
              value: "__REQUEST_PATH__"
            - name: TEST_MODE
              value: "__TEST_MODE__"
            - name: NO_CONNECTION_REUSE
              value: "__NO_CONNECTION_REUSE__"
            - name: SERVER_DELAY_MS
              value: "__SERVER_DELAY_MS__"
            - name: TIMEOUT
              value: "__TIMEOUT__"
            - name: SLEEP_MS
              value: "__SLEEP_MS__"
            - name: ALLOWED_RPS
              value: "__ALLOWED_RPS__"
            - name: BLOCKED_RPS
              value: "__BLOCKED_RPS__"
            - name: BLOCKED_TARGET_URL
              value: "__BLOCKED_TARGET_URL__"
            - name: BLOCKED_METHOD
              value: "__BLOCKED_METHOD__"
            - name: BLOCKED_PATH
              value: "__BLOCKED_PATH__"
            - name: SCENARIO_VARIANT
              value: "__SCENARIO_VARIANT__"
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: "4"
              memory: 2Gi
          volumeMounts:
            - name: k6-scripts
              mountPath: /scripts
            - name: results
              mountPath: /results
      volumes:
        - name: k6-scripts
          configMap:
            name: k6-scripts
        - name: results
          emptyDir: {}
